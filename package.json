{
  "name": "@cloudauthn/vfs-sync",
  "version": "0.1.16",
  "description": "Multi-peer folder sync for OPFS, the File System Access API and Node fs — a git-style content-addressed engine with renames, tombstones and mtime conflict resolution.",
  "keywords": [
    "sync",
    "opfs",
    "file-system-access",
    "vfs",
    "content-addressed",
    "merge",
    "offline-first",
    "crdt"
  ],
  "homepage": "https://github.com/cloudauthn/vfs-sync#readme",
  "bugs": {
    "url": "https://github.com/cloudauthn/vfs-sync/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudauthn/vfs-sync.git"
  },
  "license": "MIT",
  "author": "Jesús Germade <jesus@germade.dev>",
  "type": "module",
  "main": "./dist/vfs-sync.cjs",
  "module": "./dist/vfs-sync.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vfs-sync.js",
      "require": "./dist/vfs-sync.cjs",
      "default": "./dist/vfs-sync.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/vfs-sync.global.js",
  "jsdelivr": "./dist/vfs-sync.global.js",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && npm run types",
    "types": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "explorer": "vite explorer",
    "explorer:build": "vite build explorer",
    "pages:build": "npm run demo:build && npm run test:coverage && rm -rf demo/dist/coverage && cp -R coverage demo/dist/coverage",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.0",
    "globals": "^15.14.0",
    "preact": "^10.29.7",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
